{
	"schemaVersion": 1,
	"id": "diorama",
	"version": "${version}",
	"name": "Diorama",
	"description": "A ray-traced, angled voxel map and minimap.",
	"authors": [
		"Dara Adedeji"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/diorama-map",
		"sources": "https://github.com/SunkenInTime/minecraft-orthogonal-map",
		"issues": "https://github.com/SunkenInTime/minecraft-orthogonal-map/issues"
	},
	"license": "MIT",
	"icon": "assets/diorama/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.diorama.fabric.DioramaFabric"
		],
		"modmenu": [
			"dev.diorama.fabric.ModMenuCompat"
		]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/diorama-map"
			}
		}
	},
	"mixins": [
		"diorama.mixins.json"
	]
}
